<mvc:View
    displayBlock="true"
    controllerName="clientcinema.controller.MyTickets"
    height="100%"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
>
    <Page id="_IDGenPage1"
        title="🎬 LUFTHANSA PREMIUM CINEMA EXPERIENCE"
        showHeader="true"
        enableScrolling="true"
    >
        <!-- Section : Table with Search -->
        <VBox id="_IDGenVBox1" class="sapUiMediumMargin">
            <!-- Table Header with Search -->
            <Toolbar id="_IDGenToolbar2">
                <Title id="_IDGenTitle1"
                    text="Ticket Available"
                    level="H2"
                />
                <ToolbarSpacer id="_IDGenToolbarSpacer1" />
                <SearchField id="_IDGenSearchField1"
                    width="15rem"
                    liveChange="onSearch"
                    placeholder="Search..."
                />
            </Toolbar>

            <!-- Table -->
            <Table id="_IDGenTable"
                items="{ path: 'MyTicketsModel>/' }"
                growing="true"
                growingThreshold="20"
                sticky="ColumnHeaders"
                class="sapUiSmallMarginTop"
            >
                <columns>
                    <Column id="_IDGenColumn4"
                        width="6rem"
                        hAlign="Center"
                    >
                        <Text id="_IDGenText6" text="Poster" />
                    </Column>
                    <Column id="_IDGenColumn5">
                        <Text id="_IDGenText7" text="Title" />
                    </Column>
                    <Column id="_IDGenColumn6">
                        <Text id="_IDGenText8" text="Hall" />
                    </Column>
                    <Column id="_IDGenColumn7">
                        <Text id="_IDGenText9" text="Seat Number" />
                    </Column>
                    <Column id="_IDGenColumn8">
                        <Text id="_IDGenText10" text="Show Date" />
                    </Column>
                    <Column id="_IDGenColumn9">
                        <Text id="_IDGenText11" text="Show Time" />
                    </Column>
                    <Column id="_IDGenColumn10">
                        <Text id="_IDGenText12" text="Price" />
                    </Column>

                </columns>

                <items>
                    <ColumnListItem id="_IDGenColumnListItem2"
                        type="Navigation"
                        press="onTicketPress"
                    >
                        <cells>
                            <Image id="_IDGenImage1"
                                width="80px"
                                height="120px"
                                src="{ path: 'MyTicketsModel>MovieID', formatter: '.formatter.imageURL' }"
                                densityAware="false"
                            />
                            <Text id="_IDGenText13"
                                text="{MyTicketsModel>Title}"
                                class="sapUiTinyMarginBegin"
                            />
                            <Text id="_IDGenText14"
                                text="{MyTicketsModel>HallName}"
                                class="sapUiTinyMarginBegin"
                            />
                            <Text id="_IDGenText15"
                                text="{MyTicketsModel>SeatNumber}"
                                class="sapUiTinyMarginBegin"
                            />
                            <Text id="_IDGenText16"
                                text="{path: 'MyTicketsModel>ShowDate', formatter: '.formatter.formatTableDates'}"
                                class="sapUiTinyMarginBegin"
                            />
                            <Text id="_IDGenText17"
                                text="{path: 'MyTicketsModel>ShowTime', formatter: '.formatter.formatTableTime'}"
                                class="sapUiTinyMarginBegin"
                            />
                            <Text id="_IDGenText18"
                                 text="{ parts: ['MyTicketsModel>Price','MyTicketsModel>Currency'], formatter: '.formatter.concatStrings'}"
                                class="sapUiTinyMarginBegin"
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
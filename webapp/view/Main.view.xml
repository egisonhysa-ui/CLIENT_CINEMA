

       <mvc:View
    displayBlock="true"
    controllerName="clientcinema.controller.Main"
    height="100%"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
>
    <Page
        id="mainPage"
        title="🎬 LUFTHANSA PREMIUM CINEMA EXPERIENCE"
        showHeader="true"
        enableScrolling="true"
    >
        <headerContent>
            <Button
                id="btnTICKETS"
                text="My Tickets"
                icon="sap-icon://save"
                press=".onMyTickets"
                type="Emphasized"
                tooltip="See My Tickets"
                class="sapUiSmallMargin"
            />
        </headerContent>

<HBox id="section1" class="sapUiSmallMargin" justifyContent="SpaceBetween" alignItems="Stretch">
    
    <VBox id="_IDGenVBox7" width="33%" justifyContent="Center" class="sapUiSmallMarginEnd">
        <Carousel id="_IDGenCarousel"
            pages="{MoviesJSONModel>/}"
            loop="true"
            height="200px"
            width="100%"
        >
            <pages>
                <GenericTile id="_IDGenGenericTile"
                    backgroundImage="{path: 'MoviesJSONModel>MovieID', formatter: '.formatter.imageURL'}"
                    frameType="TwoByOne"
                    press=".onTilePress"
                    header="{MoviesJSONModel>Title}"
                    width="100%"
                />
            </pages>
        </Carousel>
    </VBox>

    <VBox id="_IDGenVBox6"  justifyContent="Center" alignItems="Center" class="sapUiSmallMarginEnd">
        <Image id="_IDGenImage2"
            src="/img/lufthansa_cinema.png"
            densityAware="false"
            width="180px"
            height="180px"
            decorative="false"
            alt="Company Logo"
        />
    </VBox>
      
    <VBox id="_IDGenVBox8"  width="33%" justifyContent="Center" class="sapUiSmallMarginEnd">
        <Carousel id="_IDGenCarousel1"
            pages="{MoviesJSONModel>/}"
            loop="true"
            height="200px"
            width="100%"
        >
            <pages>
                <GenericTile id="_IDGenGenericTile1" 
                    backgroundImage="{path: 'MoviesJSONModel>MovieID', formatter: '.formatter.imageURL'}"
                    frameType="TwoByOne"
                    press=".onTilePress"
                    header="{MoviesJSONModel>Title}"
                    width="100%"
                />
            </pages>
        </Carousel>
    </VBox>

</HBox>



        <!-- Section 2: Table with Search -->
        <VBox id="section2" class="sapUiMediumMargin">
            <!-- Table Header with Search -->
            <Toolbar id="_IDGenToolbar">
                <Title id="_IDGenTitle"
                    text="Movies Available"
                    level="H2"
                />
                <ToolbarSpacer id="_IDGenToolbarSpacer" />
                <SearchField id="_IDGenSearchField"
                    width="15rem"
                    liveChange="onSearchMovie"
                    placeholder="Search movies..."
                />
            </Toolbar>

            <!-- Movies Table -->
            <Table
                id="MoviesTable"
                items="{ path: 'MoviesJSONModel>/' }"
                growing="true"
                growingThreshold="20"
                sticky="ColumnHeaders"
                class="sapUiSmallMarginTop"
            >
                <columns>
                    <Column id="_IDGenColumn"
                        width="6rem"
                        hAlign="Center"
                    >
                        <Text id="_IDGenText" text="Poster" />
                    </Column>
                    <Column id="_IDGenColumn1">
                        <Text id="_IDGenText1" text="Title" />
                    </Column>
                    <Column id="_IDGenColumn2"
                        width="10rem"
                        hAlign="Center"
                    >
                        <Text id="_IDGenText2" text="Release Date" />
                    </Column>
                    <Column id="_IDGenColumn3"
                        width="8rem"
                        hAlign="Center"
                    >
                        <Text id="_IDGenText3" text="Duration" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem id="_IDGenColumnListItem"
                        type="Navigation"
                        press="onMoviePress"
                    >
                        <cells>
                            <Image id="_IDGenImage"
                                width="80px"
                                height="120px"
                                src="{ path: 'MoviesJSONModel>MovieID', formatter: '.formatter.imageURL' }"
                                densityAware="false"
                            />
                            <Text id="_IDGenText4"
                                text="{MoviesJSONModel>Title}"
                                class="sapUiTinyMarginBegin"
                            />
                            <Text id="_IDGenText5"
                                text="{path: 'MoviesJSONModel>ReleaseDate', formatter: '.formatter.formatTableDates'}"
                            />
                            <Text id="_IDGenText0"
                                text="{path: 'MoviesJSONModel>DurationMin', formatter: '.formatter.formatDuration'}"
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
<Carousel
    id="featuredMoviesCarousel"
    pages="{MoviesJSONModel>/}"
    loop="true"
    height="400px"
    class="sapUiSmallMarginTop featuredCarousel"
>
    <pages>
        <FlexBox id="_IDGenFlexBox4" 
           alignItems="Stretch"
          
           
           justifyContent="Center"
           class="fullSizeTile"
        >
        <!-- <VBox id="_IDGdsajdisajox6" height="400%" width="100%"> -->
            <GenericTile id="_IDGenGenericTile" 
                frameType="OneByOne"
                press=".onTilePress"
                
                backgroundImage="{path: 'MoviesJSONModel>MovieID', formatter: '.formatter.imageURL'}"
                class="carouselPage"
            />
             <!-- </VBox>  -->
        </FlexBox>
    </pages>
</Carousel>

